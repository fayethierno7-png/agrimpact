# ==========================================================
# AGRIMPACT — Configuration d'Environnement
# ==========================================================

# 1. Supabase (Postgres & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 2. Configuration Email SMTP Réel (Gmail, Brevo, Resend, Mailgun, OVH, etc.)
# Si non configuré, le système utilise un transporteur de test automatique avec prévisualisation en direct
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-d-application
SMTP_FROM=AGRIMPACT Sénégal <contact@agrimpact.sn>

# 3. Passerelle de Paiement Mobile UnitechPay (Wave & Orange Money Sénégal, CI, TG, BF, BJ)
# Obtenez votre clé sur https://pay.unitech.sn
UNITECHPAY_API_KEY=votre-cle-api-unitechpay
NEXT_PUBLIC_APP_URL=https://www.agrimpact.app
